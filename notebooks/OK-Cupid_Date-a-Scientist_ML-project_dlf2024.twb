    <worksheet name='match table'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ff3399' fontname='Tw Cen MT Condensed Extra Bold'>Match Table for Profile IDs 106 and 59749</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='profiles_with_best_cosine_matches.csv+ (Multiple Connections)' name='federated.0xy5iq31ir0z4n19skat514gxiqe' />
          </datasources>
          <datasource-dependencies datasource='federated.0xy5iq31ir0z4n19skat514gxiqe'>
            <column caption='Diet Type' datatype='string' name='[Calculation_1167839731610173446]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [diet_code]&#13;&#10;    WHEN 1 THEN &quot;anything&quot;&#13;&#10;    WHEN 2 THEN &quot;other&quot;&#13;&#10;    WHEN 3 THEN &quot;vegetarian&quot;&#13;&#10;    WHEN 4 THEN &quot;vegan&quot;&#13;&#10;    WHEN 5 THEN &quot;halal&quot;&#13;&#10;    WHEN 6 THEN &quot;kosher&quot;&#13;&#10;END' />
            </column>
            <column caption='Offsprings Has Label' datatype='string' name='[Calculation_1189794780150493184]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [offspring_has]&#13;&#10;    WHEN 0 THEN &quot;has 0 kid&quot;&#13;&#10;    WHEN 1 THEN &quot;has 1 kid&quot;&#13;&#10;    WHEN 2 THEN &quot;has &gt;1 kid&quot;    &#13;&#10;END' />
            </column>
            <column caption='Offspring Wants Label' datatype='string' name='[Calculation_1189794780151095297]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [offspring_wants]&#13;&#10;    WHEN 0 THEN &quot;doesn&apos;t want kids&quot;&#13;&#10;    WHEN 1 THEN &quot;might want kids&quot;&#13;&#10;    WHEN 2 THEN &quot;wants kids&quot;    &#13;&#10;END' />
            </column>
            <column caption='Pets Cat label' datatype='string' name='[Calculation_1189794780153143299]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [pets_cat]&#13;&#10;    WHEN 0 THEN &quot;dislikes cats&quot;&#13;&#10;    WHEN 1 THEN &quot;likes cats&quot;&#13;&#10;    WHEN 2 THEN &quot;has cats&quot;    &#13;&#10;END' />
            </column>
            <column caption='Pets Dog Label' datatype='string' name='[Calculation_1189794780153413636]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [pets_dog]&#13;&#10;    WHEN 0 THEN &quot;dislikes dogs&quot;&#13;&#10;    WHEN 1 THEN &quot;likes dogs&quot;&#13;&#10;    WHEN 2 THEN &quot;has dogs&quot;    &#13;&#10;END' />
            </column>
            <column caption='Drinks Level Label' datatype='string' name='[Calculation_1189794780155777029]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [drinks_level]&#13;&#10;    WHEN 0 THEN &quot;drinking: no&quot;&#13;&#10;    WHEN 1 THEN &quot;drinking: rarely&quot;&#13;&#10;    WHEN 2 THEN &quot;drinking: socially&quot;&#13;&#10;    WHEN 3 THEN &quot;drinking: often&quot;&#13;&#10;    WHEN 4 THEN &quot;drinking: very often&quot;&#13;&#10;    WHEN 5 THEN &quot;drinking: desperately&quot;&#13;&#10;END' />
            </column>
            <column caption='Drugs Level Label' datatype='string' name='[Calculation_1189794780156416006]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [drugs_level]&#13;&#10;    WHEN 0 THEN &quot;drug use: no&quot;&#13;&#10;    WHEN 1 THEN &quot;drug use: sometimes&quot;&#13;&#10;    WHEN 2 THEN &quot;drug use: often&quot;&#13;&#10;END' />
            </column>
            <column caption='Smokes Code Label' datatype='string' name='[Calculation_1189794780158275592]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [smokes_code]&#13;&#10;    WHEN 0 THEN &quot;smoking: no&quot;&#13;&#10;    WHEN 1 THEN &quot;smoking: quitting&quot;&#13;&#10;    WHEN 2 THEN &quot;smoking: sometimes&quot;&#13;&#10;    WHEN 3 THEN &quot;smoking: when drinking&quot;&#13;&#10;    WHEN 4 THEN &quot;smoking: regularly&quot;&#13;&#10;END' />
            </column>
            <column caption='Religion Code Label' datatype='string' name='[Calculation_1189794780160114697]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [religion_code]&#13;&#10;    WHEN 0 THEN &quot;agnosticism&quot;&#13;&#10;    WHEN 1 THEN &quot;atheism&quot;&#13;&#10;    WHEN 2 THEN &quot;buddhism&quot;&#13;&#10;    WHEN 3 THEN &quot;catholicism&quot;&#13;&#10;    WHEN 4 THEN &quot;christianity&quot;&#13;&#10;    WHEN 5 THEN &quot;hinduism&quot;&#13;&#10;    WHEN 6 THEN &quot;islam&quot;&#13;&#10;    WHEN 7 THEN &quot;judaism&quot;&#13;&#10;    WHEN 8 THEN &quot;other&quot;&#13;&#10;END' />
